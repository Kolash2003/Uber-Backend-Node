generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String?
  firstName         String
  lastName          String
  email             String?   @unique
  emailVerified     Boolean   @default(false)
  phoneNumber       String?   @unique
  role              String    @default("rider") // "rider" | "driver"
  rating            Float     @default(4.9)
  totalTrips        Int       @default(0)
  photoUrl          String? // Better Auth "image" is mapped onto this column
  isOnline          Boolean   @default(false) // driver online flag
  lastLat           Float?
  lastLng           Float?
  lastAddress       String? // reverse-geocoded label for lastLat/lastLng
  locationUpdatedAt DateTime?
  vehicle           Json? // { make, model, color, licensePlate, year }
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  bookings       Booking[]       @relation("PassengerBookings")
  driverBookings Booking[]       @relation("DriverBookings")
  paymentMethods PaymentMethod[]
  savedPlaces    SavedPlace[]
}

// Better Auth managed tables (PascalCase model names mapped via auth config)
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Booking {
  id               String    @id @default(cuid())
  passengerId      String
  driverId         String?
  rideType         String    @default("economy")
  status           String    @default("searching") // searching|matched|en_route|arrived|in_progress|completed|cancelled
  pickup           Json // frontend Address { id,label,primary,secondary?,location:{lat,lng} }
  dropoff          Json // frontend Address
  fare             Json // frontend FareEstimate
  paymentMethodId  String?
  distanceKm       Float?
  etaSeconds       Int?
  rating           Int?
  tip              Float?
  feedback         String?
  startedAt        DateTime?
  completedAt      DateTime?
  requestExpiresAt DateTime? // incoming-request countdown deadline
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  passenger User  @relation("PassengerBookings", fields: [passengerId], references: [id], onDelete: Cascade)
  driver    User? @relation("DriverBookings", fields: [driverId], references: [id])

  @@index([passengerId, status])
  @@index([driverId, status])
}

model PaymentMethod {
  id         String   @id @default(cuid())
  userId     String
  brand      String
  last4      String
  expMonth   Int
  expYear    Int
  isDefault  Boolean  @default(false)
  holderName String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  label     String
  primary   String
  secondary String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
